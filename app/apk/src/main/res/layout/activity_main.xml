<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Miuix / HyperOS shell.

        A single toolbar sits at the top, the content fills the middle and the
        primary navigation lives in a rounded bottom navigation bar.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?colorSurface"
        android:orientation="vertical"
        app:consumeSystemWindowsInsets="start|end"
        app:edgeToEdge="true"
        app:fitsSystemWindowsInsets="start|end">

        <LinearLayout
            android:id="@+id/main_toolbar_wrapper"
            style="@style/WidgetFoundation.Appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?colorSurface"
            app:fitsSystemWindowsInsets="top">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/main_toolbar"
                style="@style/WidgetFoundation.Toolbar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/internal_action_bar_size"
                android:background="?colorSurface"
                app:contentInsetStart="0dp"
                app:contentInsetStartWithNavigation="0dp"
                tools:title="Home" />

        </LinearLayout>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/main_nav_host"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:defaultNavHost="true"
            app:navGraph="@navigation/main" />

        <LinearLayout
            android:id="@+id/main_navigation"
            style="@style/WidgetFoundation.BottomNavBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:fitsSystemWindowsInsets="start|end|bottom">

            <LinearLayout
                android:id="@+id/main_nav_home"
                style="@style/WidgetFoundation.BottomNavItem"
                android:contentDescription="@string/section_home">

                <ImageView
                    style="@style/WidgetFoundation.BottomNavItem.Icon"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_nav_home" />

                <TextView
                    style="@style/WidgetFoundation.BottomNavItem.Label"
                    android:duplicateParentState="true"
                    android:text="@string/section_home" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/main_nav_superuser"
                style="@style/WidgetFoundation.BottomNavItem"
                android:contentDescription="@string/superuser">

                <ImageView
                    style="@style/WidgetFoundation.BottomNavItem.Icon"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_nav_superuser" />

                <TextView
                    style="@style/WidgetFoundation.BottomNavItem.Label"
                    android:duplicateParentState="true"
                    android:text="@string/superuser" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/main_nav_modules"
                style="@style/WidgetFoundation.BottomNavItem"
                android:contentDescription="@string/modules">

                <ImageView
                    style="@style/WidgetFoundation.BottomNavItem.Icon"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_nav_modules" />

                <TextView
                    style="@style/WidgetFoundation.BottomNavItem.Label"
                    android:duplicateParentState="true"
                    android:text="@string/modules" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/main_nav_settings"
                style="@style/WidgetFoundation.BottomNavItem"
                android:contentDescription="@string/settings">

                <ImageView
                    style="@style/WidgetFoundation.BottomNavItem.Icon"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_nav_settings" />

                <TextView
                    style="@style/WidgetFoundation.BottomNavItem.Label"
                    android:duplicateParentState="true"
                    android:text="@string/settings" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</layout>
