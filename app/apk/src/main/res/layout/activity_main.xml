<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Old style layout: a dense, two row action bar.

        Row one is the primary action bar: a compact branding icon, the primary
        navigation toggles and the actions of the current screen, all packed
        tightly together. Row two is a scrollable tool palette holding the
        smaller, secondary tools of the current screen.

        The app bar is part of the layout flow, so it always sits above the
        content.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?colorSurface"
        android:orientation="vertical"
        app:consumeSystemWindowsInsets="start|end|bottom"
        app:edgeToEdge="true"
        app:fitsSystemWindowsInsets="start|end|bottom"
        tools:ignore="RtlHardcoded">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/main_toolbar_wrapper"
            style="@style/WidgetFoundation.Appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?colorSurfaceSurfaceVariant"
            app:fitsSystemWindowsInsets="top">

            <!-- Row 1: primary action bar -->
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/main_toolbar"
                style="@style/WidgetFoundation.Toolbar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dense_bar_height"
                android:background="?colorSurfaceSurfaceVariant"
                app:contentInsetStart="0dp"
                app:contentInsetStartWithNavigation="0dp"
                tools:title="Home">

                <LinearLayout
                    android:id="@+id/main_bar_group"
                    style="@style/WidgetFoundation.NavToggleBar">

                    <ImageView
                        android:id="@+id/main_bar_brand"
                        style="@style/WidgetFoundation.BarBrand"
                        android:contentDescription="@string/supersu"
                        android:src="@drawable/ic_app_logo_padded" />

                    <LinearLayout
                        android:id="@+id/main_nav_group"
                        style="@style/WidgetFoundation.NavToggleBar">

                        <ImageView
                            android:id="@+id/main_nav_home"
                            style="@style/WidgetFoundation.NavToggle"
                            android:contentDescription="@string/section_home"
                            android:src="@drawable/ic_home_outlined" />

                        <ImageView
                            android:id="@+id/main_nav_superuser"
                            style="@style/WidgetFoundation.NavToggle"
                            android:contentDescription="@string/superuser"
                            android:src="@drawable/ic_superuser_outlined" />

                        <ImageView
                            android:id="@+id/main_nav_modules"
                            style="@style/WidgetFoundation.NavToggle"
                            android:contentDescription="@string/modules"
                            android:src="@drawable/ic_module_outlined" />

                        <ImageView
                            android:id="@+id/main_nav_settings"
                            style="@style/WidgetFoundation.NavToggle"
                            android:contentDescription="@string/settings"
                            android:src="@drawable/ic_settings_outlined" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.appbar.MaterialToolbar>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?colorBorder" />

            <!-- Row 2: dense, scrollable tool palette -->
            <HorizontalScrollView
                android:id="@+id/main_tools_scroll"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tool_palette_height"
                android:background="?colorSurface"
                android:fadingEdgeLength="@dimen/l1"
                android:requiresFadingEdge="horizontal"
                android:scrollbars="none"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/main_tools"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/l_25"
                    android:paddingEnd="@dimen/l_25" />

            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="?colorPrimary" />

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/main_nav_host"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:defaultNavHost="true"
            app:navGraph="@navigation/main" />

    </LinearLayout>

</layout>
