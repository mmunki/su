<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Old style layout: a flat top bar made of the title toolbar plus the
        navigation row (which replaced the bottom navigation bar). The app bar
        is part of the layout flow, so it always sits above the content.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?colorSurface"
        android:orientation="vertical"
        app:consumeSystemWindowsInsets="start|end|bottom"
        app:edgeToEdge="true"
        app:fitsSystemWindowsInsets="start|end|bottom"
        tools:ignore="RtlHardcoded">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/main_toolbar_wrapper"
            style="@style/WidgetFoundation.Appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?colorSurfaceSurfaceVariant"
            app:fitsSystemWindowsInsets="top">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/main_toolbar"
                style="@style/WidgetFoundation.Toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?colorSurfaceSurfaceVariant"
                tools:title="Home" />

            <LinearLayout
                android:id="@+id/main_top_nav"
                style="@style/WidgetFoundation.TopNav"
                android:layout_width="match_parent"
                android:layout_height="@dimen/top_nav_height"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/main_nav_home"
                    style="@style/WidgetFoundation.TopNav.Item">

                    <ImageView
                        android:id="@+id/main_nav_home_icon"
                        style="@style/WidgetFoundation.TopNav.Icon"
                        android:src="@drawable/ic_home_outlined" />

                    <TextView
                        android:id="@+id/main_nav_home_label"
                        style="@style/WidgetFoundation.TopNav.Label"
                        android:text="@string/section_home" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/main_nav_superuser"
                    style="@style/WidgetFoundation.TopNav.Item">

                    <ImageView
                        android:id="@+id/main_nav_superuser_icon"
                        style="@style/WidgetFoundation.TopNav.Icon"
                        android:src="@drawable/ic_superuser_outlined" />

                    <TextView
                        android:id="@+id/main_nav_superuser_label"
                        style="@style/WidgetFoundation.TopNav.Label"
                        android:text="@string/superuser" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/main_nav_modules"
                    style="@style/WidgetFoundation.TopNav.Item">

                    <ImageView
                        android:id="@+id/main_nav_modules_icon"
                        style="@style/WidgetFoundation.TopNav.Icon"
                        android:src="@drawable/ic_module_outlined" />

                    <TextView
                        android:id="@+id/main_nav_modules_label"
                        style="@style/WidgetFoundation.TopNav.Label"
                        android:text="@string/modules" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/main_nav_settings"
                    style="@style/WidgetFoundation.TopNav.Item">

                    <ImageView
                        android:id="@+id/main_nav_settings_icon"
                        style="@style/WidgetFoundation.TopNav.Icon"
                        android:src="@drawable/ic_settings_outlined" />

                    <TextView
                        android:id="@+id/main_nav_settings_label"
                        style="@style/WidgetFoundation.TopNav.Label"
                        android:text="@string/settings" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="?colorPrimary" />

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/main_nav_host"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:defaultNavHost="true"
            app:navGraph="@navigation/main" />

    </LinearLayout>

</layout>
