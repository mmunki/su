<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Old style, densely packed action bar.

        A single bar holds the primary navigation as text only: four equally
        sized, uppercase tabs that share the whole width of the display. The
        bar keeps its compact height, only the width of the tabs grows.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?colorSurface"
        android:orientation="vertical"
        app:consumeSystemWindowsInsets="start|end|bottom"
        app:edgeToEdge="true"
        app:fitsSystemWindowsInsets="start|end|bottom">

        <LinearLayout
            android:id="@+id/main_toolbar_wrapper"
            style="@style/WidgetFoundation.Appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?colorSurfaceSurfaceVariant"
            app:fitsSystemWindowsInsets="top">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/main_toolbar"
                style="@style/WidgetFoundation.Toolbar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dense_bar_height"
                android:background="?colorSurfaceSurfaceVariant"
                app:contentInsetStart="0dp"
                app:contentInsetStartWithNavigation="0dp"
                tools:title="Home">

                <LinearLayout
                    android:id="@+id/main_nav_group"
                    style="@style/WidgetFoundation.NavToggleBar">

                    <TextView
                        android:id="@+id/main_nav_home"
                        style="@style/WidgetFoundation.NavToggle"
                        android:contentDescription="@string/section_home"
                        android:text="@string/section_home" />

                    <TextView
                        android:id="@+id/main_nav_superuser"
                        style="@style/WidgetFoundation.NavToggle"
                        android:contentDescription="@string/superuser"
                        android:text="@string/superuser" />

                    <TextView
                        android:id="@+id/main_nav_modules"
                        style="@style/WidgetFoundation.NavToggle"
                        android:contentDescription="@string/modules"
                        android:text="@string/modules" />

                    <TextView
                        android:id="@+id/main_nav_settings"
                        style="@style/WidgetFoundation.NavToggle"
                        android:contentDescription="@string/settings"
                        android:text="@string/settings" />

                </LinearLayout>

            </androidx.appcompat.widget.Toolbar>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?colorBorder" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="?colorPrimary" />

        </LinearLayout>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/main_nav_host"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:defaultNavHost="true"
            app:navGraph="@navigation/main" />

    </LinearLayout>

</layout>
