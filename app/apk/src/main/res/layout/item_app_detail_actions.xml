<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="su.android.ui.appinfo.AppDetailViewModel" />

    </data>

    <com.google.android.material.card.MaterialCardView
        style="@style/WidgetFoundation.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/l_50"
        android:layout_marginEnd="@dimen/l_50"
        android:layout_marginBottom="@dimen/l_50">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/l1">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="@string/app_info_section_actions"
                android:textAllCaps="true"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?colorPrimary"
                android:textStyle="bold"
                tools:text="Actions" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/l1"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    style="@style/WidgetFoundation.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:onClick="@{() -> viewModel.disableApp()}"
                    android:text="@string/app_info_action_disable"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_block"
                    app:iconPadding="@dimen/l_50"
                    app:iconSize="18dp"
                    tools:text="Disable" />

                <com.google.android.material.button.MaterialButton
                    style="@style/WidgetFoundation.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/l_50"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:onClick="@{() -> viewModel.enableApp()}"
                    android:text="@string/app_info_action_enable"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_check_circle"
                    app:iconPadding="@dimen/l_50"
                    app:iconSize="18dp"
                    tools:text="Enable" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/l_50"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    style="@style/WidgetFoundation.Button.Outlined.Error"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:onClick="@{() -> viewModel.uninstallApp()}"
                    android:text="@string/app_info_action_uninstall"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_uninstall"
                    app:iconPadding="@dimen/l_50"
                    app:iconSize="18dp"
                    tools:text="Uninstall" />

                <com.google.android.material.button.MaterialButton
                    style="@style/WidgetFoundation.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/l_50"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:onClick="@{() -> viewModel.reinstallApp()}"
                    android:text="@string/app_info_action_reinstall"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_restart"
                    app:iconPadding="@dimen/l_50"
                    app:iconSize="18dp"
                    tools:text="Reinstall" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</layout>
