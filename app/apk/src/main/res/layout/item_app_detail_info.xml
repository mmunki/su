<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="su.android.ui.appinfo.AppDetailInfoItem" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:background="?colorSurfaceVariant"
        android:orientation="horizontal"
        android:padding="@dimen/l1">

        <ImageView
            android:id="@+id/detail_info_icon"
            style="@style/WidgetFoundation.Image.Small"
            android:layout_marginTop="@dimen/l_25"
            android:tint="?colorPrimary"
            app:srcCompat="@{item.icon}"
            tools:src="@drawable/ic_info" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/l1"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@{item.label}"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?colorOnSurfaceVariant"
                tools:text="Package name" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/l_25"
                android:text="@{item.value}"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?colorOnSurface"
                android:textIsSelectable="@{item.selectable}"
                tools:text="su.android" />

        </LinearLayout>

    </LinearLayout>

</layout>
