<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="su.android.R" />

        <variable
            name="item"
            type="su.android.ui.appinfo.AppInfoRvItem" />

        <variable
            name="viewModel"
            type="su.android.ui.appinfo.AppInfoViewModel" />

    </data>

    <com.google.android.material.card.MaterialCardView
        style="@style/WidgetFoundation.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/l_50"
        android:clickable="true"
        android:focusable="true"
        android:onClick="@{() -> viewModel.openApp(item)}">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/l1">

            <ImageView
                android:id="@+id/app_icon"
                style="@style/WidgetFoundation.Image.Big"
                android:src="@{item.icon}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@drawable/ic_launcher" />

            <TextView
                android:id="@+id/app_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/l1"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="@{item.label}"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/app_chevron"
                app:layout_constraintStart_toEndOf="@+id/app_icon"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="SuperSU" />

            <TextView
                android:id="@+id/app_package"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/l1"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="@{item.packageName}"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?colorOnSurfaceVariant"
                app:layout_constraintEnd_toEndOf="@+id/app_name"
                app:layout_constraintStart_toStartOf="@+id/app_name"
                app:layout_constraintTop_toBottomOf="@+id/app_name"
                tools:text="su.android" />

            <TextView
                android:id="@+id/app_version"
                gone="@{item.versionName.empty}"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/l1"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="@{@string/app_info_version_format(item.versionName)}"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?colorPrimary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/app_name"
                app:layout_constraintStart_toStartOf="@+id/app_name"
                app:layout_constraintTop_toBottomOf="@+id/app_package"
                tools:text="Version 1.0.0" />

            <ImageView
                android:id="@+id/app_chevron"
                style="@style/WidgetFoundation.Image.Small"
                android:layout_marginStart="@dimen/l1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_chevron_right" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</layout>
