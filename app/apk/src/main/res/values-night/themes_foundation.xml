<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ThemeFoundationBase.Holo" parent="ThemeFoundationBase">
        <!-- Holo Dark color roles (classic Material only) -->
        <item name="colorPrimary">#33B5E5</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <item name="colorSecondary">#33B5E5</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <item name="colorError">#FF4444</item>
        <item name="colorOnError">#FFFFFF</item>

        <item name="colorOnBackground">#FFFFFF</item>
        <item name="colorSurface">#000000</item>
        <item name="colorOnSurface">#FFFFFF</item>

        <!-- App specific tokens -->
        <item name="colorSurfaceSurfaceVariant">#1A1A1A</item>
        <item name="colorTextSecondary">#B0B0B0</item>
        <item name="colorBorder">#333333</item>
        <item name="colorDisabled">#666666</item>
        <item name="colorDisabledVariant">#44666666</item>
    </style>

    <style name="ThemeFoundationBase.Miuix" parent="ThemeFoundationBase">
        <!-- Miuix / HyperOS dark color roles -->
        <item name="isLightTheme">false</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#8E8E93</item>
        <item name="android:textColorTertiary">#8E8E93</item>
        <item name="android:textColorPrimaryInverse">#000000</item>
        <item name="android:textColorHint">#8E8E93</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorBackground">#000000</item>

        <item name="colorPrimary">#3482FF</item>
        <item name="colorPrimaryVariant">#2A6BFF</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <item name="colorSecondary">#3482FF</item>
        <item name="colorSecondaryVariant">#2A6BFF</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <item name="colorError">#FF453A</item>
        <item name="colorOnError">#FFFFFF</item>

        <item name="colorOnBackground">#FFFFFF</item>
        <item name="colorSurface">#000000</item>
