<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--region Colors-->

    <!--Static-->
    <attr name="colorDisabled" format="color" />
    <attr name="colorDisabledVariant" format="color" />
    <attr name="colorSurfaceSurfaceVariant" format="color" />
    <attr name="colorTextSecondary" format="color" />
    <attr name="colorBorder" format="color" />

    <!--
        Classic color roles that used to be provided by the Material Components
        library. They are owned by this app now that the app is built purely on
        AndroidX/AppCompat widgets.
    -->
    <attr name="colorSurface" format="color" />
    <attr name="colorOnSurface" format="color" />
    <attr name="colorOnBackground" format="color" />
    <attr name="colorOnPrimary" format="color" />
    <attr name="colorSecondary" format="color" />
    <attr name="colorOnSecondary" format="color" />
    <attr name="colorPrimaryVariant" format="color" />
    <attr name="colorSecondaryVariant" format="color" />
    <attr name="colorOnError" format="color" />

    <!--
        Text appearance roles. These used to be provided by the Material
        Components library; the app owns them now and maps them on the flat
        Holo appearances below.
    -->
    <attr name="textAppearanceHeadline6" format="reference" />
    <attr name="textAppearanceSubtitle1" format="reference" />
    <attr name="textAppearanceBody1" format="reference" />
    <attr name="textAppearanceCaption" format="reference" />
    <attr name="textAppearanceOverline" format="reference" />
    <attr name="textAppearanceButton" format="reference" />

    <!--endregion-->

</resources>
