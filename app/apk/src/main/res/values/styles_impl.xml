<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="WidgetFoundation.Appbar">
        <item name="android:background">?colorSurface</item>
        <item name="android:elevation">0dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="WidgetFoundation.Toolbar" parent="Widget.AppCompat.Toolbar">
        <item name="titleTextAppearance">@style/AppearanceFoundation.ToolbarTitle</item>
        <item name="titleTextColor">?colorOnSurface</item>
        <item name="subtitleTextAppearance">@style/AppearanceFoundation.Caption</item>
        <item name="subtitleTextColor">?colorTextSecondary</item>
        <item name="android:background">?colorSurface</item>
        <item name="contentInsetStart">@dimen/l1</item>
        <item name="contentInsetStartWithNavigation">@dimen/l_50</item>
        <item name="android:layout_height">?actionBarSize</item>
        <item name="android:elevation">0dp</item>
        <item name="popupTheme">@style/ThemeOverlay.Foundation.Toolbar</item>
        <item name="android:theme">@style/ThemeOverlay.Foundation.Toolbar.ActionBar</item>
    </style>

    <!-- Miuix bottom navigation bar. -->
    <style name="WidgetFoundation.BottomNavBar">
        <item name="android:background">@drawable/foundation_bottom_nav_background</item>
        <item name="android:elevation">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">@dimen/l_50</item>
        <item name="android:paddingTop">@dimen/l_50</item>
        <item name="android:paddingEnd">@dimen/l_50</item>
        <item name="android:paddingBottom">@dimen/l_50</item>
    </style>

    <style name="WidgetFoundation.BottomNavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/foundation_bottom_nav_item_background</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/l_25</item>
        <item name="android:paddingTop">@dimen/l_50</item>
        <item name="android:paddingEnd">@dimen/l_25</item>
        <item name="android:paddingBottom">@dimen/l_50</item>
    </style>

    <style name="WidgetFoundation.BottomNavItem.Icon" parent="">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:tint">@color/color_bottom_nav_item</item>
    </style>

    <style name="WidgetFoundation.BottomNavItem.Label" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/l_25</item>
        <item name="android:ellipsize">end</item>
        <item name="android:singleLine">true</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/color_bottom_nav_item</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="WidgetFoundation.Card">
        <item name="android:background">@drawable/foundation_card_background</item>
        <item name="android:focusable">auto</item>
    </style>

    <style name="WidgetFoundation.Card.Primary">
        <item name="android:background">@drawable/foundation_card_background_primary</item>
    </style>

    <style name="WidgetFoundation.Card.Elevated">
        <item name="android:background">@drawable/foundation_card_background</item>
        <item name="android:elevation">0dp</item>
    </style>


    <style name="WidgetFoundation.Button" parent="Widget.AppCompat.Button">
        <item name="miuixButtonStyle">filled</item>
        <item name="android:drawablePadding">@dimen/l_50</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WidgetFoundation.Button.Outlined" parent="Widget.AppCompat.Button.Borderless.Colored">
        <item name="miuixButtonStyle">outlined</item>
        <item name="android:background">@drawable/foundation_button_outlined_background</item>
        <item name="android:drawablePadding">@dimen/l_50</item>
        <item name="android:drawableTint">?colorPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?colorPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WidgetFoundation.Button.Outlined.Error">
        <item name="android:background">@drawable/foundation_button_outlined_error_background</item>
        <item name="android:drawableTint">@color/color_error_transient</item>
        <item name="android:textColor">@color/color_error_transient</item>
    </style>

    <style name="WidgetFoundation.Button.Text" parent="Widget.AppCompat.Button.Borderless">
        <item name="miuixButtonStyle">text</item>
        <item name="android:drawablePadding">@dimen/l_50</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WidgetFoundation.Button.Text.OnPrimary">
        <item name="android:drawableTint">?colorOnPrimary</item>
        <item name="android:textColor">?colorOnPrimary</item>
    </style>


    <style name="WidgetFoundation.Image">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
    </style>

    <style name="WidgetFoundation.Image.Big">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
    </style>

    <style name="WidgetFoundation.Image.Small">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
    </style>


    <style name="WidgetFoundation.Icon" parent="WidgetFoundation.Image.Big">
        <item name="android:background">?selectableItemBackgroundBorderless</item>
        <item name="android:padding">@dimen/l_75</item>
        <item name="android:tint">@color/color_text_transient</item>
    </style>

    <style name="WidgetFoundation.Icon.Primary">
        <item name="android:tint">@color/color_primary_transient</item>
    </style>

    <style name="WidgetFoundation.Icon.OnPrimary">
        <item name="android:tint">@color/color_on_primary_transient</item>
    </style>

    <style name="WidgetFoundation.Fab" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="WidgetFoundation.Checkbox" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:paddingStart">@dimen/l1</item>
        <item name="android:paddingEnd">@dimen/l1</item>
    </style>

    <style name="WidgetFoundation.RadioButton" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:paddingStart">@dimen/l1</item>
        <item name="android:paddingEnd">@dimen/l1</item>
    </style>

    <style name="WidgetFoundation.ProgressBar" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:indeterminate">false</item>
        <item name="android:layout_height">4dp</item>
        <item name="android:progressDrawable">@drawable/foundation_progress_bar</item>
    </style>

    <style name="WidgetFoundation.ProgressBar.Indeterminate" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:indeterminate">true</item>
        <item name="android:indeterminateTint">?colorPrimary</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">100dp</item>
    </style>

    <style name="WidgetFoundation.ProgressBar.Circular" parent="Widget.AppCompat.ProgressBar">
        <item name="android:indeterminate">true</item>
        <item name="android:indeterminateTint">?colorPrimary</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
    </style>

    <style name="WidgetFoundation.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/foundation_edit_text_background</item>
        <item name="android:paddingStart">@dimen/l1</item>
        <item name="android:paddingTop">@dimen/l_50</item>
        <item name="android:paddingEnd">@dimen/l1</item>
        <item name="android:paddingBottom">@dimen/l_50</item>
        <item name="android:textColor">?colorOnSurface</item>
        <item name="android:textColorHint">?colorTextSecondary</item>
    </style>

</resources>
