<resources>

    <!--
        Miuix / HyperOS theme, built purely on AndroidX/AppCompat (no Google
        Material library anywhere): dark surfaces, rounded cards and the MIUI
        blue accent.
    -->
    <style name="Base.V23.Theme.Foundation" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="dialogTheme">@style/ThemeOverlay.Foundation.Dialog</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>

        <!--region Miuix / HyperOS palette-->
        <item name="android:colorBackground">#000000</item>
        <item name="colorOnBackground">#FFFFFF</item>

        <item name="colorSurface">#000000</item>
        <item name="colorOnSurface">#FFFFFF</item>

        <item name="colorPrimary">#3482FF</item>
        <item name="colorPrimaryDark">#2A6BFF</item>
        <item name="colorPrimaryVariant">#2A6BFF</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <item name="colorSecondary">#3482FF</item>
        <item name="colorSecondaryVariant">#2A6BFF</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <item name="colorError">#FF453A</item>
        <item name="colorOnError">#FFFFFF</item>

        <!--region Miuix control colors-->
        <item name="colorAccent">#3482FF</item>
        <item name="android:colorAccent">#3482FF</item>
        <item name="colorControlNormal">#8E8E93</item>
        <item name="colorControlActivated">#3482FF</item>
        <item name="colorControlHighlight">#333482FF</item>
        <item name="colorButtonNormal">#1C1C1E</item>
        <item name="colorBackgroundFloating">#1C1C1E</item>
        <item name="android:colorBackgroundFloating">#1C1C1E</item>
        <!--endregion-->

        <!--region Miuix highlights instead of Material ripples-->
        <item name="selectableItemBackground">@drawable/foundation_selectable_item_background</item>
        <item name="selectableItemBackgroundBorderless">@drawable/foundation_selectable_item_background_borderless</item>
        <item name="android:selectableItemBackground">@drawable/foundation_selectable_item_background</item>
        <item name="android:selectableItemBackgroundBorderless">@drawable/foundation_selectable_item_background_borderless</item>
        <!--endregion-->

        <!--region Foundation roles (app owned)-->
        <item name="colorSurfaceSurfaceVariant">#1C1C1E</item>
        <item name="colorTextSecondary">#8E8E93</item>
        <item name="colorBorder">#2C2C2E</item>
        <!--endregion-->

        <!--region Miuix widgets-->
        <item name="buttonStyle">@style/WidgetFoundation.Button</item>
        <item name="checkboxStyle">@style/WidgetFoundation.Checkbox</item>
        <item name="radioButtonStyle">@style/WidgetFoundation.RadioButton</item>
        <!--endregion-->

        <!--region Text appearance roles-->
        <item name="textAppearanceHeadline6">@style/AppearanceFoundation.Large</item>
        <item name="textAppearanceSubtitle1">@style/AppearanceFoundation.Title</item>
        <item name="textAppearanceBody1">@style/AppearanceFoundation.Body</item>
        <item name="textAppearanceCaption">@style/AppearanceFoundation.Caption</item>
        <item name="textAppearanceOverline">@style/AppearanceFoundation.Tiny</item>
        <item name="textAppearanceButton">@style/AppearanceFoundation.Caption</item>
        <!--endregion-->
    </style>

    <style name="Base.V23.Theme.Foundation.Light" parent="Base.V23.Theme.Foundation" />

    <style name="Theme.Foundation.Light" parent="Base.V23.Theme.Foundation.Light" />

    <style name="Theme.Foundation" parent="Base.V23.Theme.Foundation" />

    <style name="Base.V23.ThemeOverlay.Foundation.Dialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowMinWidthMajor">@dimen/abc_dialog_min_width_major</item>
        <item name="android:windowMinWidthMinor">@dimen/abc_dialog_min_width_minor</item>

        <!-- Miuix dialog surface -->
        <item name="android:colorBackground">#1C1C1E</item>
        <item name="colorSurface">#1C1C1E</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorSurfaceSurfaceVariant">#2C2C2E</item>
        <item name="colorTextSecondary">#8E8E93</item>
        <item name="colorPrimary">#3482FF</item>
        <item name="colorSecondary">#3482FF</item>
        <item name="colorAccent">#3482FF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#8E8E93</item>
    </style>

    <style name="ThemeOverlay.Foundation.Dialog" parent="Base.V23.ThemeOverlay.Foundation.Dialog" />

</resources>
