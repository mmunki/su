<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ThemeFoundationBase" parent="Foundation.Default" />

    <style name="ThemeFoundationBase.Holo" parent="ThemeFoundationBase">
        <!-- Holo Dark color roles (classic Material only) -->
        <item name="colorPrimary">#33B5E5</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <item name="colorSecondary">#33B5E5</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <item name="colorError">#FF4444</item>
        <item name="colorOnError">#FFFFFF</item>

        <item name="colorOnBackground">#FFFFFF</item>
        <item name="colorSurface">#000000</item>
        <item name="colorOnSurface">#FFFFFF</item>

        <!-- App specific tokens -->
        <item name="colorSurfaceSurfaceVariant">#1A1A1A</item>
        <item name="colorTextSecondary">#B0B0B0</item>
        <item name="colorBorder">#333333</item>
        <item name="colorDisabled">#666666</item>
        <item name="colorDisabledVariant">#44666666</item>
    </style>

    <style name="ThemeFoundationBase.Miuix" parent="ThemeFoundationBase">
        <!-- Miuix / HyperOS light color roles -->
        <item name="isLightTheme">true</item>
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textColorSecondary">#7A7A7E</item>
        <item name="android:textColorTertiary">#7A7A7E</item>
        <item name="android:textColorPrimaryInverse">#FFFFFF</item>
        <item name="android:textColorHint">#7A7A7E</item>
        <item name="android:windowBackground">#F7F7F7</item>
        <item name="android:statusBarColor">#F7F7F7</item>
        <item name="android:navigationBarColor">#F7F7F7</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorBackground">#F7F7F7</item>

        <item name="colorPrimary">#3482FF</item>
        <item name="colorPrimaryVariant">#2A6BFF</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <item name="colorSecondary">#3482FF</item>
        <item name="colorSecondaryVariant">#2A6BFF</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <item name="colorError">#FF3B30</item>
        <item name="colorOnError">#FFFFFF</item>

        <item name="colorOnBackground">#000000</item>
        <item name="colorSurface">#F7F7F7</item>
        <item name="colorOnSurface">#000000</item>

        <!-- Miuix control colors -->
        <item name="colorAccent">#3482FF</item>
        <item name="android:colorAccent">#3482FF</item>
        <item name="colorControlNormal">#7A7A7E</item>
        <item name="colorControlActivated">#3482FF</item>
        <item name="colorControlHighlight">#263482FF</item>
        <item name="colorButtonNormal">#FFFFFF</item>
        <item name="colorBackgroundFloating">#FFFFFF</item>
        <item name="android:colorBackgroundFloating">#FFFFFF</item>

        <!-- App specific tokens -->
        <item name="colorSurfaceSurfaceVariant">#FFFFFF</item>
        <item name="colorTextSecondary">#7A7A7E</item>
        <item name="colorBorder">#E5E5EA</item>
        <item name="colorDisabled">#B0B0B5</item>
        <item name="colorDisabledVariant">#66B0B0B5</item>
    </style>

</resources>
